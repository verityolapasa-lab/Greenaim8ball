
-- GREEN AIM 8 BALL
-- Version 1.0
-- Original trajectory visualizer for your own Roblox Studio game

local GreenAim = {}

GreenAim.Settings = {
    LineColor = Color3.fromRGB(0, 255, 80),
    LineWidth = 0.12,
    MaxDistance = 60,
}

function GreenAim.DrawTrajectory(origin, direction, parent)
    if not origin or not direction or not parent then
        warn("Green Aim: missing parameters")
        return nil
    end

    local distance = math.min(
        direction.Magnitude,
        GreenAim.Settings.MaxDistance
    )

    if distance <= 0 then
        return nil
    end

    local part = Instance.new("Part")
    part.Name = "GreenAimTrajectory"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Material = Enum.Material.Neon
    part.Color = GreenAim.Settings.LineColor

    part.Size = Vector3.new(
        GreenAim.Settings.LineWidth,
        GreenAim.Settings.LineWidth,
        distance
    )

    part.CFrame = CFrame.lookAt(
        origin + direction.Unit * (distance / 2),
        origin + direction.Unit * distance
    )

    part.Parent = parent

    return part
end

function GreenAim.Clear(parent)
    if not parent then return end

    for _, object in ipairs(parent:GetChildren()) do
        if object.Name == "GreenAimTrajectory" then
            object:Destroy()
        end
    end
end

return GreenAim
